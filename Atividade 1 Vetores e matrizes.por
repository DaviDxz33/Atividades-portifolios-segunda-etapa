programa
{
	
	funcao inicio()
	
	{
		
inteiro v[5]
		para (inteiro i = 0; i < 5; i++)
		{
			escreva ("Escolha o ",i,"º número:")
			leia(v[i])
		}
		para (inteiro j = 4;j>=0;j--)
		{
			escreva (v[j], " \n")
		}
	}
}

