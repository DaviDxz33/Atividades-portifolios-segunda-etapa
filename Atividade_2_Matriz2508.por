programa
{
	
	funcao inicio()
	{
		inteiro tabela[3][3]
		para(inteiro i = 0; i < 3; i++)
		{
			escreva(i,"linha")
			para(inteiro j = 0; j < 3; j++)
		{
			escreva("[",i,"][",j,"]:")
			leia (tabela[i] [j])
		}
		}
		          escreva (tabela[0][0], "\n")
		          escreva (tabela[1][1], "\n")
				escreva (tabela[2][2], "\n")

	}
}

